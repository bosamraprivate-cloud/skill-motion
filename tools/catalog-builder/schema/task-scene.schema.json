{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitherapist.local/schema/task-scene.schema.json",
  "title": "Per-task scene objects (Story 6.4 follow-up)",
  "description": "task_scene.json: for every task id, the object kinds that must be visible before a session starts (AI scene check). Staging only; never changes scoring. Emitted as 'sceneObjects' on each task in assessment.json.",
  "type": "object",
  "properties": {"_source": {"type": "string"}},
  "propertyNames": {"pattern": "^(_source|[a-z]+([.][a-z]+)+)$"},
  "additionalProperties": {
    "type": "array",
    "uniqueItems": true,
    "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "enum": ["table", "chair", "cup", "plate", "bowl", "spoon", "fork", "sandwich", "bottle", "straw", "sink", "soap", "towel", "toothbrush", "toothpaste", "jacket", "tshirt", "shirt", "trousers", "socks", "shoes"]
    }
  }
}
